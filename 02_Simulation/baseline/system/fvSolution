FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    // Explicit governing equations (Mass, Momentum, Total Energy)
    "(rho|rhoU|rhoE).*"
    {
        solver          diagonal;
    }

    // Implicit viscous corrections
    "(U|e).*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-08;
        relTol          0.1;
    }

    // Turbulence solver optimized for boundary layers
    "(k|omega).*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-08;
        relTol          0.1;
    }
}

// RelaxationFactors block removed to ensure temporal consistency 
// of the Navier-Stokes equations under transient operating conditions.

